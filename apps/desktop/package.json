{
  "name": "@ims-pro/desktop",
  "version": "1.0.0",
  "description": "Galaxy Cashier — جالاكسي كاشير — Galaxy Digital",
  "author": "Galaxy Digital",
  "main": "main.js",
  "scripts": {
    "dev":           "electron .",
    "build:win":       "electron-builder --win --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "build:portable":  "electron-builder --win portable --x64",
    "build:dir":     "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId":            "com.galaxydigital.cashier",
    "productName":      "Galaxy Cashier",
    "copyright":        "Copyright © 2026 Galaxy Digital",
    "electronVersion":  "31.7.7",
    "asar":             true,
    "directories": {
      "output":          "dist",
      "buildResources":  "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "staging/api",
        "to":   "api",
        "filter": ["**/*"]
      },
      {
        "from": "staging/web",
        "to":   "web",
        "filter": ["**/*"]
      },
      {
        "from": "staging/node",
        "to":   "node",
        "filter": ["**/*"]
      },
      {
        "from": "assets/seed.db",
        "to":   "seed.db"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName} ${version}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "جالاكسي كاشير",
      "uninstallDisplayName": "Galaxy Cashier — جالاكسي كاشير",
      "runAfterFinish": true,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "installerLanguages": ["en_US"],
      "language": "1033",
      "displayLanguageSelector": false,
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron":         "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
